{
  "name": "monopoly-lan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "start": "npm run build && npm run serve",
    "build": "npm run build -w @monopoly/client",
    "serve": "npm run start -w @monopoly/server --",
    "dev:client": "npm run dev -w @monopoly/client",
    "test": "npm test -w @monopoly/engine && npm test -w @monopoly/server",
    "typecheck": "tsc -p packages/engine && tsc -p packages/server && tsc -p packages/client"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
